{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm --prefix client install",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist/client/browser",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://shree-ganesh-kirana-api.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
